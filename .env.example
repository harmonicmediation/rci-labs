# Copy to .env.local for Next.js. Never commit real secrets.
# Convex dashboard env vars are set separately (npx convex env set ...).

# --- Required for local auth + backend ---
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_APP_URL=https://app.fulfillmentbuilder.com

# Clerk JWT issuer for Convex (also set on the Convex deployment)
# Example: https://your-instance.clerk.accounts.dev
CLERK_JWT_ISSUER_DOMAIN=

# --- Required for live video ---
DAILY_API_KEY=
DAILY_DOMAIN=

# --- Required for AI moderation/reports ---
OPENAI_API_KEY=
OPENAI_LIVE_MODEL=gpt-4.1-mini
OPENAI_REPORT_MODEL=gpt-4.1

# --- Optional ---
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# Shared secret for Pipecat observer -> Convex /internal/observer/events
OBSERVER_SHARED_SECRET=

# Local-only service keys used by seed (override in production)
# The seed mutation stores only a hash.
RCI_DEV_SERVICE_API_KEY=rci_svc_dev_local_only
RCI_DEV_PRIVACY_API_KEY=rci_privacy_dev_local_only
